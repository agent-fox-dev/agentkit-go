# A toolchain image for the harness example: specr (the spec package renderer
# from github.com/agent-fox-dev/spec) on top of the AgentKit sandbox image,
# which holds git and the sandbox agent that sandbox/podman starts as the
# container's process (at sandbox.AgentPath).
#
#   podman build -t agentkit-harness:latest -f Containerfile .
#
# The host and the agent must be the same AgentKit version — Sandbox.Tools
# checks the tool definitions' digest — so a development checkout builds its
# own base image with `make build-sandbox-container` (tagged latest) and a
# release builds with --build-arg SANDBOX_IMAGE=quay.io/agentfox/agentkit-sandbox:X.Y.Z.

ARG SPEC_VERSION=main

# specr is built from a clone, not with `go install …/cmd/specr@version`: the
# spec module carries a replace for agentkit-go, which go install rejects, and
# no release tag has cmd/specr yet (v1.4.1 predates it). SPEC_VERSION is any
# branch or tag of the spec repository.
FROM registry.redhat.io/ubi10/go-toolset:latest AS build

USER root

ARG SPEC_VERSION
WORKDIR /build

ENV GOTOOLCHAIN=auto

RUN git clone --depth 1 --branch ${SPEC_VERSION} https://github.com/agent-fox-dev/spec /build \
 && cd /build \
 && GOBIN=/out CGO_ENABLED=0 go install \
      -ldflags "-X github.com/agent-fox-dev/spec.Version=${SPEC_VERSION} -X github.com/agent-fox-dev/spec.Commit=$(git rev-parse --short HEAD)" \
      ./cmd/specr

FROM quay.io/agentfox/agentkit-sandbox:latest

USER root

COPY --from=build /out/specr /usr/local/bin/specr

WORKDIR /workspace
USER 1001:0
