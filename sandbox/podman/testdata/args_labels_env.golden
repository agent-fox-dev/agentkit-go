run
--rm
-i
--init
--name
agentkit-0123456789abcdef
--label
agentkit.sandbox=0123456789abcdef
--label
agentkit.sandbox.expires=2025-01-02T03:04:05Z
--label
app=a
--label
mid=c
--label
zone=b
--log-driver
none
--network
none
--cap-drop
ALL
--security-opt
no-new-privileges
--read-only
--tmpfs
/tmp:rw,exec,nosuid,nodev,mode=1777
--mount
type=volume,source=agentkit-0123456789abcdef,target=/workspace
--unsetenv-all
--env
A_B=two words
--env
HOME=/workspace/.home
--env
LANG=C.UTF-8
--env
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
--env
TERM=dumb
--env
TMPDIR=/tmp
--env
X=1
--entrypoint
/usr/local/bin/agentkit-sandboxd
img:1
--ttl
1h0m0s
--network
none
--workdir
/workspace
