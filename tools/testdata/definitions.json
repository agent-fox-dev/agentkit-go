          "type": "string",
          "description": "Directory to search from (default the workspace root)"
        },
        "file_type": {
          "type": "string",
          "description": "What to match: \"file\" (default), \"dir\" or \"any\""
        },
        "limit": {
          "type": "integer",
          "description": "Maximum results (default 200, at most 1000)"
        }
      },
      "required": [
        "pattern"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "marker": {
          "type": "string"
        }
      },
      "required": [
        "files",
        "truncated"
      ]
    },
    "prompt_guidelines": null,
    "builtin": true,
    "execution_mode": 0
  },
  {
    "name": "search_files",
    "description": "Search file contents by regular expression, skipping .gitignored, hidden (dot-prefixed) and binary files. Returns at most max_matches (\u003c= 100) matches with context_lines (\u003c= 20) lines either side.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Regular expression (RE2 syntax)"
        },
        "path": {
          "type": "string",
          "description": "Directory to search from (default the workspace root)"
        },
        "context_lines": {
          "type": "integer",
          "description": "Lines of context either side of a match (0 to 20)",
          "minimum": 0,
          "maximum": 20
        },
        "file_glob": {
          "type": "string",
          "description": "Only search files matching this glob, e.g. **/*.py or src/**/*.ts"
        },
        "case_sensitive": {
          "type": "boolean",
          "description": "Omit for smart-case: a lowercase pattern matches any case"
        },
        "max_matches": {
          "type": "integer",
          "description": "Maximum matches to return (1 to 100; default 100)",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "pattern"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              },
              "before": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "file",
              "line",
              "text"
            ]
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "files_searched": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "matches",
        "truncated",
        "files_searched"
      ]
    },
    "prompt_guidelines": null,
    "builtin": true,
    "execution_mode": 0
  },
