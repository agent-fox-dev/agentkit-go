  {
    "name": "execute",
    "description": "Run a shell command in the workspace root. Pipes, redirection, \u0026\u0026 and $() all work. Only the last 50 KB of output is kept, so the tail of a failing build is preserved. No default timeout; pass timeout_s for anything that may not exit. A background process must redirect its output (\u003e log 2\u003e\u00261 \u0026) or it is killed when the tool returns.",
    "input_schema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "The shell command to run"
        },
        "timeout_s": {
          "type": "integer",
          "description": "Seconds before the process tree is killed"
        }
      },
      "required": [
        "command"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "exit",
            "signal",
            "timeout",
            "abort"
          ]
        }
      },
      "required": [
        "output",
        "exit_code",
        "outcome"
      ]
    },
    "prompt_guidelines": null,
    "builtin": true,
    "execution_mode": 1
  },
  {
    "name": "run_command",
    "description": "Run a program with an explicit argument list and NO shell. Pipes, redirection, globs and $() do not work here — use execute for those. Prefer this when arguments come from data, since nothing is re-parsed.",
    "input_schema": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "description": "Program and arguments, e.g. [\"git\", \"commit\", \"-m\", \"a message\"]",
          "items": {
            "type": "string"
          }
        },
        "timeout_s": {
          "type": "integer",
          "description": "Seconds before the process tree is killed"
        }
      },
      "required": [
        "argv"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "exit",
            "signal",
            "timeout",
            "abort"
          ]
        }
      },
      "required": [
        "output",
        "exit_code",
        "outcome"
      ]
    },
    "prompt_guidelines": [
      "Use run_command when an argument contains spaces or shell metacharacters; nothing is re-parsed by a shell."
    ],
    "builtin": true,
    "execution_mode": 1
  }
]
