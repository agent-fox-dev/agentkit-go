[
  {
    "name": "read_file",
    "description": "Read a text file. At most 2000 lines or 50KB are returned, whichever comes first.",
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the file (relative to the workspace, or absolute)"
        },
        "offset": {
          "type": "integer",
          "description": "1-based line to start from (default 1)"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum lines to return"
        }
      },
      "required": [
        "path"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "encoding"
      ]
    },
    "prompt_guidelines": [
      "Read a file before editing it."
    ],
    "builtin": true,
    "execution_mode": 0
  },
  {
    "name": "write_file",
    "description": "Write a file, creating or replacing it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to write"
        },
        "content": {
          "type": "string",
          "description": "Full file content"
        }
      },
      "required": [
        "path",
        "content"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "written": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer"
        }
      },
      "required": [
        "written",
        "bytes"
      ]
    },
    "prompt_guidelines": [
      "Prefer edit_file for an existing file; write_file replaces the whole file."
    ],
    "builtin": true,
    "execution_mode": 1
  },
  {
    "name": "edit_file",
    "description": "Apply one or more exact-match edits to a file. Every old_string is matched against the ORIGINAL file content, not against the result of an earlier edit in the same call. Each old_string must appear exactly once; if it appears more than once the call is rejected, so include enough surrounding context to make it unique.",
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to edit"
        },
        "edits": {
          "type": "array",
          "description": "Edits to apply, all matched against the original content",
          "items": {
            "type": "object",
            "properties": {
              "old_string": {
                "type": "string",
                "description": "Exact text to replace; must be unique in the file"
              },
              "new_string": {
                "type": "string",
                "description": "Replacement text"
              }
            },
            "required": [
              "old_string",
              "new_string"
            ]
          }
        }
      },
      "required": [
        "path",
        "edits"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "edits_applied": {
          "type": "integer"
        }
      },
      "required": [
        "edits_applied"
      ]
    },
    "prompt_guidelines": null,
    "builtin": true,
    "execution_mode": 1
  },
  {
    "name": "list_files",
    "description": "List the entries of a directory, directories with a trailing /. Does not apply .gitignore.",
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Directory to list (default the workspace root)"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum entries (default 200, at most 500)"
        }
      }
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "entries",
        "truncated"
      ]
    },
    "prompt_guidelines": null,
    "builtin": true,
    "execution_mode": 0
  },
  {
    "name": "find_files",
    "description": "Find files by glob pattern, skipping .gitignored paths.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Glob pattern, e.g. **/*.py or src/**/*.ts"
