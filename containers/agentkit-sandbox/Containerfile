FROM registry.redhat.io/ubi10/go-toolset:latest AS build

ARG VERSION=dev
ARG BUILD=dev
ARG BUILD_TIME=

USER root
WORKDIR /build

ENV GOTOOLCHAIN=auto
RUN go version

COPY go.mod go.sum ./
COPY sandbox/go.mod sandbox/go.sum ./sandbox/
RUN cd sandbox && go mod download
COPY . .

RUN cd sandbox && \
  CGO_ENABLED=1 GOOS=linux go build -trimpath -buildvcs=false \
  -ldflags "-s -w \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.stamp=${VERSION} \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.commit=${BUILD} \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.buildTime=${BUILD_TIME}" \
  -o /out/agentkit-sandboxd ./cmd/agentkit-sandboxd

FROM registry.redhat.io/ubi10/s2i-core:10.2 as base

ARG VERSION=dev
ARG BUILD=dev

# based on https://catalog.redhat.com/en/software/containers/ubi10/s2i-core/677cf9b05fdd0fab2f79ec5b#containerfile
USER root

ENV HOME=/home/agentkit

RUN dnf install -y --setopt=tsflags=nodocs --setopt=install_weak_deps=0 git-core bash ca-certificates && \
    dnf -y clean all --enablerepo='*' && \
    install -d -o 1001 -g 0 -m 0775 /workspace "$HOME" && \
    git config --system --add safe.directory '*'

COPY --from=build /out/agentkit-sandboxd /usr/local/bin/agentkit-sandboxd

LABEL org.opencontainers.image.source="https://github.com/agent-fox-dev/agentkit-go" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="agentkit-sandbox" \
      org.opencontainers.image.description="The AgentKit sandbox agent, agentkit-sandboxd, at /usr/local/bin/agentkit-sandboxd" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${BUILD}"

WORKDIR /workspace
USER 1001:0

ENTRYPOINT ["/usr/local/bin/agentkit-sandboxd"]