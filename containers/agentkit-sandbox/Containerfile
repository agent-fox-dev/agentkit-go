FROM registry.redhat.io/ubi10/go-toolset:latest AS build

ARG VERSION=dev
ARG BUILD=dev
ARG BUILD_TIME=

USER root
WORKDIR /build

ENV GOTOOLCHAIN=auto
RUN go version

COPY go.mod go.sum ./
COPY sandbox/go.mod sandbox/go.sum ./sandbox/
RUN cd sandbox && go mod download
COPY . .

RUN cd sandbox && \
  CGO_ENABLED=1 go build -trimpath -buildvcs=false \
  -ldflags "-s -w \
    -X github.com/agent-fox-dev/agentkit.Version=${VERSION} \
    -X github.com/agent-fox-dev/agentkit.Commit=${BUILD} \
    -X github.com/agent-fox-dev/agentkit.BuildTime=${BUILD_TIME}" \
  -o /out/agentkit-sandboxd ./cmd/agentkit-sandboxd

FROM registry.redhat.io/ubi10/s2i-core:10.2 as base

ARG VERSION=dev
ARG BUILD=dev

# based on https://catalog.redhat.com/en/software/containers/ubi10/s2i-core/677cf9b05fdd0fab2f79ec5b#containerfile
USER root

ENV APP_ROOT=/opt/app-root \
  HOME=/opt/app-root/src \
  PATH=/opt/app-root/src/bin:/opt/app-root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  PLATFORM="el10"

RUN INSTALL_PKGS="git \
  wget bzip2 zip which" && \
  mkdir -p ${HOME}/.pki/nssdb && \
  chown -R 1001:0 ${HOME}/.pki && \
  dnf install -y --setopt=tsflags=nodocs $INSTALL_PKGS && \
  rpm -V $INSTALL_PKGS && \
  dnf -y clean all --enablerepo='*'

RUN rpm-file-permissions

COPY --from=build /out/agentkit-sandboxd /usr/bin/agentkit-sandboxd
LABEL org.opencontainers.image.source="https://github.com/agent-fox-dev/agentkit-go" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="agentkit-sandbox" \
      org.opencontainers.image.description="The AgentKit sandbox agent, agentkit-sandboxd, at /usr/local/libexec/agentkit-sandboxd" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${BUILD}"

WORKDIR ${HOME}
USER 1001:1001

ENTRYPOINT ["/usr/bin/agentkit-sandboxd"]