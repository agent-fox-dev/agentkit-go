FROM registry.redhat.io/ubi10/go-toolset:latest AS build

ARG VERSION=dev
ARG BUILD=dev
ARG BUILD_TIME=

USER root
WORKDIR /build

ENV GOTOOLCHAIN=auto
RUN go version

COPY go.mod go.sum ./
COPY sandbox/go.mod sandbox/go.sum ./sandbox/
RUN cd sandbox && go mod download
COPY . .

RUN cd sandbox && \
  CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false \
  -ldflags "-s -w \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.stamp=${VERSION} \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.commit=${BUILD} \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.buildTime=${BUILD_TIME}" \
  -o /out/agentkit-sandboxd ./cmd/agentkit-sandboxd

FROM scratch AS overlay

ARG VERSION=dev
ARG BUILD=dev

COPY --from=build /out/agentkit-sandboxd /usr/local/libexec/agentkit-sandboxd

LABEL org.opencontainers.image.source="https://github.com/agent-fox-dev/agentkit-go" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="agentkit-sandbox" \
      org.opencontainers.image.description="The AgentKit sandbox agent, agentkit-sandboxd, at /usr/local/libexec/agentkit-sandboxd" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${BUILD}"

ENTRYPOINT ["/usr/local/libexec/agentkit-sandboxd"]