FROM registry.redhat.io/ubi10/go-toolset:latest AS build

# The AGENTKIT_ prefix keeps these clear of the UBI images' own ENV
# VERSION, which would override an ARG of the same name.
ARG AGENTKIT_VERSION=
ARG AGENTKIT_REVISION=
ARG AGENTKIT_BUILD_TIME=

USER root
WORKDIR /build

ENV GOTOOLCHAIN=auto
RUN go version

COPY go.mod go.sum ./
COPY sandbox/go.mod sandbox/go.sum ./sandbox/
RUN cd sandbox && go mod download
COPY . .

RUN cd sandbox && \
  CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false \
  -ldflags "-s -w \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.stamp=${AGENTKIT_VERSION} \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.commit=${AGENTKIT_REVISION} \
    -X github.com/agent-fox-dev/agentkit-go/sandbox/internal/buildver.buildTime=${AGENTKIT_BUILD_TIME}" \
  -o /out/agentkit-sandboxd ./cmd/agentkit-sandboxd

FROM scratch AS overlay

ARG AGENTKIT_VERSION=
ARG AGENTKIT_REVISION=

COPY --from=build /out/agentkit-sandboxd /usr/local/libexec/agentkit-sandboxd

LABEL org.opencontainers.image.source="https://github.com/agent-fox-dev/agentkit-go" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="agentkit-sandboxd" \
      org.opencontainers.image.description="The static AgentKit sandbox agent, agentkit-sandboxd, alone at /usr/local/libexec/agentkit-sandboxd, for COPY --from into a toolchain image" \
      org.opencontainers.image.version="${AGENTKIT_VERSION}" \
      org.opencontainers.image.revision="${AGENTKIT_REVISION}"

ENTRYPOINT ["/usr/local/libexec/agentkit-sandboxd"]